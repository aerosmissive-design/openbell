OPENBELL_URL=https://openbell-fawn.vercel.app
NAS_REPORT_TOKEN=
# GAS 웹앱 /exec 주소 — 여러 개면 쉼표(또는 줄바꿈)로 구분
# 예: https://script.google.com/macros/s/AAA/exec,https://script.google.com/macros/s/BBB/exec
GAS_WEB_URLS=
# 하위호환: 단일 URL만 쓸 때
# GAS_WEB_URL=
# 오픈벨 설정 gasSyncKey 와 동일 (GAS에 syncKey가 있으면 필수)
GAS_SYNC_KEY=
# pc | nas423 | nas225
REPORT_SOURCE=pc
INTERVAL_MS=60000
IMAX_INTERVAL_MS=30000
DAYS=2
THEATERS=cgv_yongsan,cgv_yeongdeungpo
