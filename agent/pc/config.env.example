# OpenBell
OPENBELL_URL=https://openbell-fawn.vercel.app
NAS_WORKER_TOKEN=REPLACE_WITH_YOUR_TOKEN

# CGV
CGV_URL=https://cgv.co.kr
PLAYWRIGHT_HEADLESS=false
CGV_STORAGE_STATE=

# Booking target
BOOKING_MOVIE=영화명
BOOKING_DATE=2026-09-20
BOOKING_SHOWTIME=20:10
BOOKING_SEAT_COUNT=2
# Exact CGV showtime URL from OpenBell scan. When set, PC Agent skips movie/date/showtime clicking and opens this exact 회차 directly.
BOOKING_URL=
# Leave empty to let Seat Ranker choose contiguous available seats automatically.
BOOKING_SEAT_IDS=

# OpenBell booking session. Set this to an existing BookingSession ID to notify OpenBell at PAYMENT_READY.
BOOKING_SESSION_ID=

# Seat Ranker preferences
SEAT_PREFERRED_ROW=
SEAT_PREFERRED_ROW_DISTANCE=
SEAT_ALLOW_AISLE=true
SEAT_ALLOW_EDGE=false

# Optional booking form fields
# BOOKING_INFO_NAME=홍길동
# BOOKING_INFO_PHONE=01000000000

# Safety: final payment is never automated
PAYMENT_HARD_STOP=true
PAYMENT_READY_TTL_MINUTES=10
# Keep the visible PC browser open after PAYMENT_READY so the user can finish payment manually.
PAYMENT_HOLD_BROWSER=true

# Telegram is configured on the OpenBell server; do not put real bot secrets in Git.
