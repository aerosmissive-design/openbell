# OpenBell API (optional). Without both OPENBELL_URL and NAS_WORKER_TOKEN the agent runs in dry-run mode.
# Copy this file to config.env (gitignored). Do not put real secrets in Git.
# Telegram is configured on the OpenBell server only.
OPENBELL_URL=https://openbell-fawn.vercel.app
NAS_WORKER_TOKEN=

# Playwright
PLAYWRIGHT_HEADLESS=false
# Optional: saved after a manual login via 4-save-login.cmd (never commit this file).
CGV_STORAGE_STATE=cgv-storage.json

# Booking target
BOOKING_MOVIE=영화명
BOOKING_DATE=2026-09-20
BOOKING_SHOWTIME=20:10
BOOKING_SEAT_COUNT=2
BOOKING_THEATER_ID=CGV용산아이파크몰
BOOKING_HALL=20관

# Exact CGV showtime URL. When set, agent opens this URL directly (must include movNo,scnYmd,scnsNo,scnSseq).
# Example: https://cgv.co.kr/cnm/movieBook/movie?movNo=...&scnYmd=...&scnsNo=...&scnSseq=...
BOOKING_URL=

# Explicit seats (comma-separated). Leave empty to auto-pick contiguous center seats.
BOOKING_SEAT_IDS=

# Existing OpenBell BookingSession id (optional). If empty and callbacks enabled, agent creates one via POST /api/booking/create.
BOOKING_SESSION_ID=

# Seat ranker preferences
SEAT_PREFERRED_ROW=
SEAT_PREFERRED_ROW_DISTANCE=
SEAT_ALLOW_AISLE=true
SEAT_ALLOW_EDGE=false

# Optional booking form fields (label -> value)
# BOOKING_INFO_NAME=홍길동
# BOOKING_INFO_PHONE=01000000000

# Safety: final payment is NEVER automated. Server PAYMENT_READY TTL = 10 minutes.
PAYMENT_HARD_STOP=true
# Keep the visible PC browser open after PAYMENT_READY so the user can finish payment manually.
PAYMENT_HOLD_BROWSER=true
