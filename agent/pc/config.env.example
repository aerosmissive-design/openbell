# OpenBell
OPENBELL_URL=https://openbell-fawn.vercel.app
NAS_WORKER_TOKEN=REPLACE_WITH_YOUR_TOKEN

# CGV
CGV_URL=https://cgv.co.kr
PLAYWRIGHT_HEADLESS=false
CGV_STORAGE_STATE=

# Booking target
BOOKING_MOVIE=영화명
BOOKING_DATE=2026-09-20
BOOKING_SHOWTIME=20:10
BOOKING_SEAT_COUNT=2
BOOKING_SEAT_IDS=A1,A2

# Optional booking form fields
# BOOKING_INFO_NAME=홍길동
# BOOKING_INFO_PHONE=01000000000

# Safety: final payment is never automated
PAYMENT_HARD_STOP=true
PAYMENT_READY_TTL_MINUTES=10

# Telegram (used by the OpenBell server notifier; do not commit real values)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_USER_ID=
TELEGRAM_WEBHOOK_SECRET=
